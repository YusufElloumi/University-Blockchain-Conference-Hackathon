# Copy to .env and fill in. Names only here - never commit real values.
# Devnet only. No mainnet keys, ever.

# --- Solana ---
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Server wallets: paths to keypair files stored OUTSIDE the repo (e.g. ~/.config/solana/loser-buys/)
ORACLE_KEYPAIR_PATH=
TREASURY_KEYPAIR_PATH=
# On a host with no files (Render): put each keypair file's contents in these secrets instead of the paths
# ORACLE_KEYPAIR=
# TREASURY_KEYPAIR=
# Verifier: signs each challenge's result (Proof of Effort, api/attest.py). Optional; without it results are not signed.
VERIFIER_KEYPAIR_PATH=
# VERIFIER_KEYPAIR=
# Optional: the verifier's public address, if it is not the default in api/config.py
VERIFIER_PUBLIC_KEY=

# --- API (FastAPI) ---
# Leave unset locally to use SQLite; set to the Neon Postgres URL when deployed
DATABASE_URL=
FITNESS_PROVIDER=mock
WEB_ORIGIN=http://localhost:5173
# Optional: fee money sent to new wallets (default 0.02 SOL) and "Add test funds" amount (default 5 USDC)
GAS_DRIP_SOL=
TEST_FUNDS_USDC=

# --- Settlement ---
# Comma-separated emails allowed to use "End week now"
ADMIN_EMAILS=
# Any long random string; the scheduler sends it in the X-Tick-Secret header to POST /internal/tick
TICK_SECRET=
# Seconds to wait after a challenge ends before paying out (0 for demos)
SETTLE_GRACE_SECONDS=0
# Proof of Sweat (optional; defaults shown). Wait after a challenge ends so rings can sync, stop waiting for a
# missing final sync, and how long imported workouts are kept after the last challenge that used them ended.
# SYNC_GRACE_SECONDS=1800
# SYNC_GIVE_UP_SECONDS=21600
# EVIDENCE_RETENTION_DAYS=7
# Leave NEW_CHALLENGE_RULES unset: new challenges then use Proof of Sweat. (The tests set it to daily_mover.)
# Optional: the oracle's public address, if it is not the default in api/config.py
ORACLE_PUBLIC_KEY=

# --- Privy ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- QuickNode Streams ---
QUICKNODE_STREAM_ID=
QUICKNODE_STREAM_SECURITY_TOKEN=

# --- Oura Ring connection (api/fitness/oura.py) ---
# From the Oura developer portal. Leave empty to show "Connect Oura" as coming soon.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Must match a redirect URI registered with Oura exactly. Deployed: https://loser-buys-api.onrender.com/integrations/oura/callback
OURA_REDIRECT_URI=
# Encrypts outside services' tokens in the database. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use a different key locally and on Render. Losing it means everyone has to reconnect Oura.
TOKEN_ENCRYPTION_KEY=

# --- Strava (optional; unused while FITNESS_PROVIDER=mock or manual) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Web (Vite; only VITE_ values reach the browser, so no secrets here) ---
VITE_API_URL=http://localhost:8000
VITE_PRIVY_APP_ID=
VITE_PROGRAM_ID=
# Optional: RPC for the browser (default public devnet) and the challenge shown when the link has none
VITE_SOLANA_RPC_URL=
VITE_DEMO_CHALLENGE=

# --- SIMULATED treasury yield (optional; defaults shown). No real funds are ever lent. ---
# GRACE_HOURS=12
# WITHDRAW_HOURS=0
# SAFETY_HOURS=24
# BUFFER_PCT=0.15
# LIQUIDITY_CAP_PCT=0.02
# APY=0.05
# Optional key for Jupiter's API (live USDC rate; works without one at a low rate limit).
JUPITER_API_KEY=
# 0 = never call Jupiter; always use APY.
# SIM_LIVE_RATE=1
